// Prisma schema — https://pris.ly/d/prisma-schema
// Postgres provider. DIRECT_URL is used for migrations / connections that must
// bypass a connection pooler (e.g. Prisma Migrate, or PgBouncer setups).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PRO
  ELITE
}

enum AccountPlatform {
  MT4
  MT5
}

enum TradeSide {
  BUY
  SELL
}

enum TradeSource {
  SYNC
  MANUAL
}

enum AccountSyncStatus {
  PENDING
  DEPLOYING
  CONNECTED
  SYNCING
  ERROR
  DISCONNECTED
}

// ---------------------------------------------------------------------------
// Application models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // Null for OAuth-only users; set for credentials sign-in. Provider account
  // ids live on the related Account records (Auth.js adapter).
  passwordHash String?
  image        String?
  emailVerified DateTime?
  plan         Plan     @default(FREE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Billing (Dodo Payments)
  dodoCustomerId     String?
  subscriptionId     String?
  subscriptionStatus String?
  planRenewsAt       DateTime?

  // Social
  displayName        String?
  leaderboardOptIn   Boolean   @default(false)
  publicShareToken   String?   @unique
  publicShareEnabled Boolean   @default(false)

  // Auth.js adapter relations
  accounts Account[]
  sessions Session[]

  // App relations
  tradingAccounts TradingAccount[]
  trades          Trade[]
  aiReports       AiReport[]
  checklistItems  ChecklistItem[]
  chatMessages    ChatMessage[]
  chatReactions   ChatReaction[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  channel   String
  userId    String
  body      String
  createdAt DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions ChatReaction[]

  @@index([channel, createdAt])
  @@index([userId])
}

model ChatReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// User-defined pre-trade checklist items. The per-trade ticked state is stored
// as JSON on JournalEntry.checklist (a snapshot of id/label/checked).
model ChecklistItem {
  id        String   @id @default(cuid())
  userId    String
  label     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TradingAccount {
  id               String          @id @default(cuid())
  userId           String
  broker           String
  login            String
  server           String
  type             AccountPlatform
  metaApiAccountId String?
  // Investor (read-only) password, encrypted at rest (AES-256-GCM).
  investorPassword String?
  isActive         Boolean           @default(true)
  status           AccountSyncStatus @default(PENDING)
  statusMessage    String?
  // Cursor: timestamp of the latest synced deal (for incremental sync).
  lastSyncedAt     DateTime?
  createdAt        DateTime          @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@index([userId])
}

model Trade {
  id               String      @id @default(cuid())
  userId           String
  tradingAccountId String?
  symbol           String
  side             TradeSide
  volume           Float
  openPrice        Float
  closePrice       Float?
  openTime         DateTime
  closeTime        DateTime?
  stopLoss         Float?
  takeProfit       Float?
  pnl              Float?
  commission       Float       @default(0)
  swap             Float       @default(0)
  source           TradeSource @default(MANUAL)
  // Broker-side id used to deduplicate synced trades. Unique per account.
  externalId       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingAccount TradingAccount? @relation(fields: [tradingAccountId], references: [id], onDelete: SetNull)
  journalEntry   JournalEntry?

  @@unique([tradingAccountId, externalId])
  @@index([userId])
  @@index([openTime])
  @@index([userId, openTime])
}

model JournalEntry {
  id             String   @id @default(cuid())
  tradeId        String   @unique
  notes          String?
  strategyTag    String?
  mood           String?
  rating         Int?
  screenshotUrls String[]
  checklist      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model AiReport {
  id          String   @id @default(cuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  grade       String?
  summary     String?
  contentJson Json
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, periodStart])
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) adapter models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
