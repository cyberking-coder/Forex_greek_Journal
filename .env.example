# --- Database (Postgres) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/forex_greek_journal?schema=public"
# Direct (non-pooled) connection used by Prisma Migrate.
DIRECT_URL="postgresql://user:password@localhost:5432/forex_greek_journal?schema=public"

# --- Auth (NextAuth / Auth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Optional: only needed if NextAuth can't infer the deployment URL.
# NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable the Google button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Anthropic ---
ANTHROPIC_API_KEY=""

# --- MetaApi (MT4/MT5 sync) ---
# If unset, a mock broker provider returns sample deals (dev only).
METAAPI_TOKEN=""
# Optional REST endpoint overrides (region-specific).
# METAAPI_PROVISIONING_URL=""
# METAAPI_CLIENT_URL=""

# --- Encryption ---
# 32-byte key (hex or base64) for encrypting stored investor passwords at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Billing (Dodo Payments) ---
# API key + webhook signing secret from the Dodo dashboard. Leave the API key
# blank to disable checkout (the billing page shows a "not configured" note).
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
# "test_mode" (default) or "live_mode".
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Subscription product ids for each tier/interval (create them in Dodo first).
DODO_PRODUCT_PRO_MONTHLY=""
DODO_PRODUCT_PRO_YEARLY=""
DODO_PRODUCT_ELITE_MONTHLY=""
DODO_PRODUCT_ELITE_YEARLY=""

# --- Storage (Supabase) ---
# Screenshot uploads. If unset, files fall back to local disk (public/uploads),
# which is for local development only — configure Supabase in production.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="screenshots"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
