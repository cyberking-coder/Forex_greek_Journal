# --- Database (Postgres) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/forex_greek_journal?schema=public"
# Direct (non-pooled) connection used by Prisma Migrate.
DIRECT_URL="postgresql://user:password@localhost:5432/forex_greek_journal?schema=public"

# --- Auth (NextAuth / Auth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Optional: only needed if NextAuth can't infer the deployment URL.
# NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable the Google button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Anthropic ---
ANTHROPIC_API_KEY=""

# --- MetaApi (MT4/MT5 sync) ---
# If unset, a mock broker provider returns sample deals (dev only).
METAAPI_TOKEN=""
# Optional REST endpoint overrides (region-specific).
# METAAPI_PROVISIONING_URL=""
# METAAPI_CLIENT_URL=""

# --- Encryption ---
# 32-byte key (hex or base64) for encrypting stored investor passwords at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Billing (Dodo Payments) ---
# API key + webhook signing secret from the Dodo dashboard. Leave the API key
# blank to disable checkout (the billing page shows a "not configured" note).
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
# "test_mode" (default) or "live_mode".
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Subscription product ids for each tier/interval (create them in Dodo first).
DODO_PRODUCT_PRO_MONTHLY=""
DODO_PRODUCT_PRO_YEARLY=""
DODO_PRODUCT_ELITE_MONTHLY=""
DODO_PRODUCT_ELITE_YEARLY=""

# --- Storage (Supabase) ---
# Screenshot uploads. If unset, files fall back to local disk (public/uploads),
# which is for local development only — configure Supabase in production.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="screenshots"

# --- Traders Lounge (Pusher realtime chat) ---
# Optional. Without these the lounge still works via HTTP polling; with them,
# messages and reactions fan out in real time. Create an app at pusher.com.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
# Public (browser) credentials — must match the server key/cluster above.
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# --- Background sync (cron / worker) ---
# Shared secret for the scheduled sync endpoint (/api/cron/sync). Vercel Cron
# sends it automatically as `Authorization: Bearer <CRON_SECRET>`. If unset, the
# endpoint is unauthenticated — always set it in production.
CRON_SECRET=""
# Standalone worker poll interval (scripts/sync-worker.ts), in milliseconds.
SYNC_INTERVAL_MS="60000"

# --- Monitoring (Sentry) ---
# All optional — Sentry is a no-op when the DSN is unset. Create a project at
# sentry.io to get a DSN. NEXT_PUBLIC_SENTRY_DSN powers browser error reporting.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Used only at build time to upload source maps (set in CI/Vercel, not locally).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Trace sampling (0..1). Lower in high-traffic production.
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# --- App ---
# Public base URL of the deployment. Used for canonical URLs, sitemap, robots,
# OpenGraph/Twitter cards, and share links. Set to your production domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional override if the marketing site lives on a different domain.
# NEXT_PUBLIC_SITE_URL="https://greekjournal.app"
