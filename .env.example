# --- Database (Postgres) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/forex_greek_journal?schema=public"
# Direct (non-pooled) connection used by Prisma Migrate.
DIRECT_URL="postgresql://user:password@localhost:5432/forex_greek_journal?schema=public"

# --- Auth (NextAuth / Auth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Optional: only needed if NextAuth can't infer the deployment URL.
# NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable the Google button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Anthropic ---
ANTHROPIC_API_KEY=""

# --- MetaApi ---
METAAPI_TOKEN=""

# --- Storage (Supabase) ---
# Screenshot uploads. If unset, files fall back to local disk (public/uploads),
# which is for local development only — configure Supabase in production.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="screenshots"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
